# Settes som Edge Function secrets: supabase secrets set --env-file .env
SUPABASE_URL=https://zesaeleooiptrpjzqhxe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=                      # lang tilfeldig streng, samme som app.cron_secret i databasen

SHOPIFY_SHOP=fhxr10-gu.myshopify.com
# Dev Dashboard-app («Garnly ruting», egen organisasjon): backenden henter token selv
# med client credentials-grant. Client ID/secret står under appens Settings.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=              # kun for eldre admin-opprettet custom app (shpat_...), ellers tom
SHOPIFY_WEBHOOK_SECRET=           # tom = bruker SHOPIFY_CLIENT_SECRET (webhooks opprettet av appen)
SHOPIFY_API_VERSION=2026-07

# Synkefrekvens. Standardverdiene ligger i _shared/schedule.ts og trenger ikke settes.
# Natt = lokal tid (Europe/Oslo), så sommertid følger med. NIGHT_SYNC_INTERVAL_MIN=0
# slår av nattsynken helt. SYNC_GRACE_MIN er slakken som gjør at 15 min faktisk blir
# 15 og ikke 20 – se filhodet i schedule.ts.
SYNC_INTERVAL_MIN=15
NIGHT_SYNC_INTERVAL_MIN=60
SYNC_NIGHT_FROM_HOUR=22
SYNC_NIGHT_TO_HOUR=8
SYNC_GRACE_MIN=2

# Duell krever kall fra fast, hvitelistet IP. Supabase har ingen fast utgående IP, så Duell-
# kallene rutes gjennom en fast-IP-proxy (QuotaGuard/Fixie e.l.) når denne er satt. Uten den
# kalles Duell direkte. Format: http://bruker:passord@host:port
DUELL_PROXY_URL=

# Varsling (valgfritt i test; uten nøkler logges meldingene bare)
RESEND_API_KEY=
NOTIFY_FROM=Garnly <ordre@garnly.no>
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
OPS_EMAIL=

# Frakt: none | shipmondo
SHIPPING_PROVIDER=none
SHIPMONDO_USER=
SHIPMONDO_KEY=
SHIPMONDO_SANDBOX=true
SHIPMONDO_PRODUCT_CODE=
SHIPMONDO_SERVICE_CODES=
SHIPMONDO_GRAMS_PER_ITEM=100
