# Settes som Edge Function secrets: supabase secrets set --env-file .env
SUPABASE_URL=https://zesaeleooiptrpjzqhxe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=                      # lang tilfeldig streng, samme som app.cron_secret i databasen

SHOPIFY_SHOP=kycbgs-yy.myshopify.com
# Dev Dashboard-app («Garnly ruting», egen organisasjon): backenden henter token selv
# med client credentials-grant. Client ID/secret står under appens Settings.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=              # kun for eldre admin-opprettet custom app (shpat_...), ellers tom
SHOPIFY_WEBHOOK_SECRET=           # tom = bruker SHOPIFY_CLIENT_SECRET (webhooks opprettet av appen)
SHOPIFY_API_VERSION=2025-07

SYNC_INTERVAL_MIN=15

# Varsling (valgfritt i test; uten nøkler logges meldingene bare)
RESEND_API_KEY=
NOTIFY_FROM=Garnly <ordre@garnly.no>
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
OPS_EMAIL=

# Frakt: none | shipmondo
SHIPPING_PROVIDER=none
SHIPMONDO_USER=
SHIPMONDO_KEY=
SHIPMONDO_SANDBOX=true
SHIPMONDO_PRODUCT_CODE=
SHIPMONDO_SERVICE_CODES=
SHIPMONDO_GRAMS_PER_ITEM=100
